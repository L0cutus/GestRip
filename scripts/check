#!/bin/sh
# Controllo completo prima del commit di una slice (l'equivalente di `mix precommit`).
# Gira tutto sotto scripts/limiti.sh. I test forzano la sola CPU.
set -eu
cd "$(dirname "$0")/.."
GO="${GO:-$HOME/sdk/go1.27.3/bin/go}"
export CGO_ENABLED=0 GOFLAGS="${GOFLAGS:--trimpath -tags=nodynamic}"
# Nessuna GPU per sbaglio nei test (il prodotto deve funzionare senza).
export CUDA_VISIBLE_DEVICES= HIP_VISIBLE_DEVICES= GGML_VK_VISIBLE_DEVICES= GESTRIP_TEST_CPU_ONLY=1
L=scripts/limiti.sh

echo "== gofmt"
out=$("$L" "$($GO env GOROOT)/bin/gofmt" -l $(git ls-files --cached --others --exclude-standard '*.go') 2>&1 || true)
if [ -n "$out" ]; then echo "file da formattare:"; echo "$out"; exit 1; fi
echo "== go vet"
"$L" "$GO" vet ./...
echo "== staticcheck"
"$L" "$GO" tool staticcheck -tags nodynamic ./...
echo "== errcheck (errori ignorati; eccezioni motivate in scripts/errcheck-escluse.txt)"
"$L" "$GO" tool errcheck -tags nodynamic -exclude scripts/errcheck-escluse.txt ./...
echo "== build (senza CGO)"
"$L" "$GO" build -o /dev/null ./...
echo "== test"
R=$(mktemp); trap 'rm -f "$R"' EXIT
if ! "$L" "$GO" test -count=1 -json ./... > "$R"; then
  # Solo se qualcosa è rosso: di nuovo in forma leggibile.
  "$L" "$GO" test -count=1 ./... || true
  exit 1
fi
grep -o '"Action":"pass","Package":"[^"]*","Elapsed' "$R" | sed 's/.*"Package":"\([^"]*\)".*/ok  \1/' || true
echo "== copertura dell'inventario"
# Con l'inventario privato controlla anche che l'elenco pubblico sia allineato; senza, legge l'elenco.
B=""
[ -n "${GESTRIP_BANCO_ESITO:-}" ] && B="-banco $GESTRIP_BANCO_ESITO"
"$L" "$GO" run ./tools/copertura -risultati "$R" -verifica $B
echo "== segreti e dati veri"
scripts/githooks/pre-commit --tutto
echo "OK"
